# Auswertung und Datenbank nur nach Login erreichbar.
AuthType Basic
AuthName "user area"
AuthUserFile /kunden/107407_12489/conf/.htusers
require valid-user

# Datenbank und Salt zusaetzlich hart sperren, falls der Schutz mal wegfaellt.
<FilesMatch "\.(sqlite|sqlite-wal|sqlite-shm|txt)$">
  Require all denied
</FilesMatch>
